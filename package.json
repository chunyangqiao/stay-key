{
  "name": "stay-key",
  "version": "0.1.0",
  "description": "Save accounts, passwords, and other secrets on this computer. Generate strong random passwords when you need one",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint src && oxfmt --check src",
    "lint:fix": "oxlint --fix src && oxfmt --write src",
    "fmt": "oxfmt --write src",
    "fmt:check": "oxfmt --check src",
    "prepare": "husky"
  },
  "keywords": [
    "password-manager",
    "chrome-extension",
    "browser-extension",
    "local-first",
    "offline",
    "password-generator",
    "secrets",
    "privacy"
  ],
  "author": "Joe <chunyangqiao91@gmail.com>",
  "license": "MIT",
  "packageManager": "pnpm@12.15.0",
  "type": "module",
  "devDependencies": {
    "@crxjs/vite-plugin": "^3.0.0",
    "@types/chrome": "^0.3.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-zip-pack": "^1.2.4"
  },
  "dependencies": {
    "date-fns": "^4.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx,mjs,cjs}": [
      "oxlint --fix",
      "oxfmt --write"
    ],
    "src/**/*.{css,html,json}": "oxfmt --write"
  }
}
