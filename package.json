{
  "name": "stay-key",
  "version": "0.1.0",
  "description": "Save accounts, passwords, and other secrets on this computer. Generate strong random passwords when you need one",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint src && oxfmt --check src",
    "lint:fix": "oxlint --fix src && oxfmt --write src",
    "fmt": "oxfmt --write src",
    "fmt:check": "oxfmt --check src",
    "test": "vitest run",
    "prepare": "husky"
  },
  "keywords": [
    "password-manager",
    "chrome-extension",
    "browser-extension",
    "local-first",
    "offline",
    "password-generator",
    "secrets",
    "privacy"
  ],
  "author": "Joe <chunyangqiao91@gmail.com>",
  "license": "MIT",
  "packageManager": "pnpm@12.15.0",
  "type": "module",
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@crxjs/vite-plugin": "^3.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.3.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-zip-pack": "^1.2.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.1",
    "date-fns": "^4.4.0",
    "fuse.js": "^7.5.0",
    "lucide-react": "^1.66.0",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx,mjs,cjs}": [
      "oxlint --fix",
      "oxfmt --write"
    ],
    "src/**/*.{css,html,json}": "oxfmt --write"
  }
}
